{
  "name": "cahs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Centralized Agro Hub — hackathon prototype (simulated finance)",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @cahs/api",
    "dev:web": "npm run dev -w @cahs/web",
    "build": "npm run build -w @cahs/shared && npm run build -w @cahs/api && npm run build -w @cahs/web",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w @cahs/api",
    "db:migrate": "npm run prisma:migrate -w @cahs/api",
    "db:seed": "npm run prisma:seed -w @cahs/api",
    "db:reset": "npm run prisma:reset -w @cahs/api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^10.1.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  }
}

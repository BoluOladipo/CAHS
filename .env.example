# Copy to .env in repo root and apps/api/.env

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://cahs:cahs@localhost:5432/cahs?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Feature flags (also stored in DB; env used as bootstrap defaults)
FF_AI=true
FF_SAVINGS=true
FF_LOYALTY=true

# GenAI: leave empty to use deterministic fallback
ANTHROPIC_API_KEY=

TZ=Africa/Lagos
